{
  "name": "proxyverse",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "test": "vitest",
    "coverage": "vitest run --coverage",
    "build": "vue-tsc && vite build",
    "build:firefox": "vue-tsc && vite build -m firefox",
    "dist": "rm -f dist.zip && cd ./dist/ && zip -r ../dist.zip ./",
    "preview": "vite preview"
  },
  "directories": {
    "test": "tests"
  },
  "dependencies": {
    "@highlightjs/vue-plugin": "^2.1.0",
    "@typescript/native-preview": "^7.0.0-dev.20260707.2",
    "@vueuse/core": "^15.0.0",
    "acorn": "^8.19.0",
    "escodegen": "^2.1.0",
    "espree": "^11.2.0",
    "io-ts": "^2.2.22",
    "ipaddr.js": "^2.5.0",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@arco-design/web-vue": "^2.58.0",
    "@types/chrome": "^0.3.5",
    "@types/escodegen": "^0.0.10",
    "@types/node": "^26.6.5",
    "@types/webextension-polyfill": "^0.12.6",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "^5.0.5",
    "rollup-plugin-visualizer": "^7.1.1",
    "sass-embedded": "^1.105.2",
    "typescript": "^6.0.3",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.13"
